# ── Banco de Dados ─────────────────────────────────────────────────────────────
# Banco operacional — dados da aplicação (rondas, bens, formulários, etc.)
# Dev:  mediall_dev  (definido em .env.development.local)
# Prod: linensistemDB (definido em .env.production.local)
DATABASE_URL="postgresql://user:password@host:5432/linensistemDB"

# Banco de autenticação centralizado — sempre aponta para Multi_UnidadesDB
# Compartilhado por todos os sistemas (LinenSistem, FeedbackForms, Compliance)
# Nunca muda por ambiente — é sempre o banco de identidade de produção
AUTH_DATABASE_URL="postgresql://user:password@host:5432/Multi_UnidadesDB"

# ── Autenticação JWT ───────────────────────────────────────────────────────────
# Chave secreta para assinar tokens JWT — deve ser idêntica no FeedbackForms SPA
# Gere com: openssl rand -base64 64
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# ── CORS ───────────────────────────────────────────────────────────────────────
# Lista separada por vírgulas das origens permitidas (SPA FeedbackForms + outros clientes)
# Exemplo: http://localhost:5173,https://app.feedbackforms.com.br
CORS_ORIGINS="http://localhost:5173"

# ── Integração Trílogo ────────────────────────────────────────────────────────
# Token de API do Trílogo (sistema de gestão de patrimônio)
TRILOGO_TOKEN="your-trilogo-api-token-here"
TRILOGO_BASE_URL="https://public.api.trilogo.app/api"

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
# OBRIGATÓRIO em produção. Sem esta variável o endpoint do cron responde 403 e
# NADA é sincronizado (ambientes + chamados do Trílogo) — a falha é silenciosa.
# Na Vercel: defina CRON_SECRET nas Environment Variables (Production) e faça
# REDEPLOY. A Vercel injeta "Authorization: Bearer <CRON_SECRET>" sozinha nas
# execuções de cron; o mesmo header serve para disparo manual (PM2 / curl).
# Gere com: openssl rand -hex 32
#      ou:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET="CHANGE_ME_IN_PRODUCTION"

# ── Node Environment ───────────────────────────────────────────────────────────
# development | production | test
NODE_ENV="development"

# ── URL pública da aplicação ───────────────────────────────────────────────────
# Usada para gerar QR codes e links públicos. Em produção: URL do Vercel/domínio próprio.
NEXT_PUBLIC_APP_URL="https://linensistem.vercel.app"

# ── Servidor (produção) ────────────────────────────────────────────────────────
# Porta em que o servidor Next.js escuta (padrão: 3000)
PORT=3000
# Hostname (padrão: 0.0.0.0 para aceitar conexões externas)
HOSTNAME="0.0.0.0"
