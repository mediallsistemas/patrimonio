generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String                  @id @default(uuid())
  slug               String                  @unique
  nome               String
  ativo              Boolean                 @default(true)
  criadoEm           DateTime                @default(now())
  trilogoCompanyId   Int?
  trilogoProjectName String?
  atualizadoEm       DateTime                @default(now()) @updatedAt
  logoUrl            String?
  feedbackForms      Boolean                 @default(false)
  linenSistem        Boolean                 @default(true)
  tipo               String                  @default("hospital")
  agendamentos       AgendamentoManutencao[]
  ambientes          AmbienteTenant[]
  blocos             BlocoTenant[]
  movimentacoes      Movimentacao[]
  pessoas            Pessoa[]
  rondasDraft        RondaDraft[]
  usuarios           Usuario[]

  @@map("tenants")
}

model Usuario {
  id                      String                  @id @default(uuid())
  tenantId                String?
  email                   String                  @unique
  senhaHash               String
  nome                    String
  role                    String                  @default("tenant_admin")
  ativo                   Boolean                 @default(true)
  criadoEm                DateTime                @default(now())
  atualizadoEm            DateTime                @default(now()) @updatedAt
  username                String?                 @unique
  mustChangePassword      Boolean                 @default(false)
  sistemas                String[]                @default([])
  agendamentosAtualizados AgendamentoManutencao[] @relation("AgendamentoAtualizadoPor")
  agendamentosCriados     AgendamentoManutencao[] @relation("AgendamentoCriadoPor")
  rodadasCriadas          Rodada[]                @relation("RodadaCriadaPor")
  draftsOcorrencias       RondaDraft[]            @relation("DraftCriadoPor")
  rondasCriadas           RondaOcorrencia[]       @relation("RondaCriadaPor")
  tenant                  Tenant?                 @relation(fields: [tenantId], references: [id])

  @@map("usuarios")
}

model Pessoa {
  id             String         @id @default(uuid())
  nome           String
  cpf            String         @unique
  faceDescriptor String
  createdAt      DateTime       @default(now())
  tenantId       String
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime?      @updatedAt
  movimentacoes  Movimentacao[]
  tenant         Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, cpf])
  @@map("pessoas")
}

model Movimentacao {
  id       String   @id @default(uuid())
  pessoaId String
  tipo     String
  dataHora DateTime @default(now())
  tenantId String
  pessoa   Pessoa   @relation(fields: [pessoaId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@map("movimentacoes")
}

model Rodada {
  id           String                 @id @default(uuid())
  iniciadoEm   DateTime               @default(now())
  finalizadoEm DateTime?
  tenantId     String
  criadoPorId  String?
  ambientes    AmbienteInspecionado[]
  criadoPor    Usuario?               @relation("RodadaCriadaPor", fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@map("rodadas")
}

model AmbienteInspecionado {
  id               String         @id @default(uuid())
  rodadaId         String
  ambiente         String
  purezaO2         Float
  pressaoO2        Float
  pressaoAr        Float
  backupLigado     Boolean
  temAlteracao     Boolean
  concluidoEm      DateTime       @default(now())
  temAbastecimento Boolean        @default(false)
  abastecimento    Abastecimento?
  alteracao        Alteracao?
  rodada           Rodada         @relation(fields: [rodadaId], references: [id])

  @@map("ambientes_inspecionados")
}

model Abastecimento {
  id                     String               @id @default(uuid())
  ambienteInspecionadoId String               @unique
  quantidade             Int
  tamanho                String
  ambienteInspecionado   AmbienteInspecionado @relation(fields: [ambienteInspecionadoId], references: [id])

  @@map("abastecimentos")
}

model Alteracao {
  id                     String               @id @default(uuid())
  ambienteInspecionadoId String               @unique
  tipo                   String
  descricao              String
  foto                   String?
  trilogoChamado         Boolean
  ambienteInspecionado   AmbienteInspecionado @relation(fields: [ambienteInspecionadoId], references: [id])

  @@map("alteracoes")
}

model RondaOcorrencia {
  id           String             @id @default(uuid())
  iniciadoEm   DateTime           @default(now())
  finalizadoEm DateTime?
  tenantId     String
  criadoPorId  String
  ambientes    RegistroAmbiente[]
  criadoPor    Usuario            @relation("RondaCriadaPor", fields: [criadoPorId], references: [id])

  @@index([criadoPorId])
  @@map("rondas_ocorrencias")
}

model RegistroAmbiente {
  id               String              @id @default(uuid())
  rondaId          String
  ambiente         String
  temOcorrencia    Boolean
  concluidoEm      DateTime            @default(now())
  tipoRegistro     String              @default("ocorrencia")
  purezaO2         Float?
  pressaoO2        Float?
  pressaoAr        Float?
  backupLigado     Boolean?
  temAbastecimento Boolean?
  qtdCilindros     Int?
  tamCilindro      String?
  ocorrencias      OcorrenciaDetalhe[]
  ronda            RondaOcorrencia     @relation(fields: [rondaId], references: [id])

  @@index([rondaId])
  @@map("registros_ambientes")
}

model OcorrenciaDetalhe {
  id             String           @id @default(uuid())
  registroId     String
  tipo           String
  descricao      String
  foto           String?
  trilogoChamado Boolean
  bemPatrimony   String?
  bemDescricao   String?
  registro       RegistroAmbiente @relation(fields: [registroId], references: [id])

  @@index([registroId])
  @@map("ocorrencias_detalhe")
}

model BlocoTenant {
  id        String           @id @default(uuid())
  tenantId  String
  nome      String
  ordem     Int              @default(0)
  ativo     Boolean          @default(true)
  ambientes AmbienteTenant[]
  tenant    Tenant           @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("blocos_tenant")
}

model AmbienteTenant {
  id       String       @id @default(uuid())
  tenantId String
  nome     String
  ordem    Int          @default(0)
  ativo    Boolean      @default(true)
  tipo     String       @default("ocorrencia")
  blocoId  String?
  bloco    BlocoTenant? @relation(fields: [blocoId], references: [id])
  tenant   Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([blocoId])
  @@map("ambientes_tenant")
}

model RondaDraft {
  id           String   @id @default(uuid())
  tenantId     String
  criadoPorId  String
  estado       Json
  atualizadoEm DateTime @default(now()) @updatedAt
  criadoPor    Usuario  @relation("DraftCriadoPor", fields: [criadoPorId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, criadoPorId])
  @@map("rondas_draft")
}

model AgendamentoManutencao {
  id              String    @id @default(uuid())
  trilogoAssetId  Int
  patrimony       String
  descricaoBem    String
  companyId       Int
  companyName     String
  ambiente        String
  dataAgendada    DateTime
  observacao      String?
  criadoEm        DateTime  @default(now())
  status          String    @default("pendente")
  titulo          String    @default("Manutenção")
  criadoPorId     String
  atualizadoEm    DateTime  @updatedAt
  atualizadoPorId String?
  dataRealizada   DateTime?
  tenantId        String?
  atualizadoPor   Usuario?  @relation("AgendamentoAtualizadoPor", fields: [atualizadoPorId], references: [id])
  criadoPor       Usuario   @relation("AgendamentoCriadoPor", fields: [criadoPorId], references: [id])
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("agendamentos_manutencao")
}

model LinkPublicoBem {
  id        String   @id @default(uuid())
  companyId Int
  projeto   String
  ambiente  String
  tenantId  String
  criadoEm  DateTime @default(now())

  @@unique([companyId, projeto, ambiente])
  @@index([companyId])
  @@map("links_publicos_bens")
}
