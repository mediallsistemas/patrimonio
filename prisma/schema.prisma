generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pessoa {
  id             String         @id @default(uuid())
  nome           String
  cpf            String         @unique
  faceDescriptor String
  createdAt      DateTime       @default(now())
  movimentacoes  Movimentacao[]

  @@map("pessoas")
}

model Movimentacao {
  id       String   @id @default(uuid())
  pessoaId String
  tipo     String
  dataHora DateTime @default(now())
  pessoa   Pessoa   @relation(fields: [pessoaId], references: [id])

  @@map("movimentacoes")
}

model Inspecao {
  id            String     @id @default(uuid())
  ambiente      String     // "HRPG" | "UEI"
  purezaO2      Float
  pressaoO2     Float
  pressaoAr     Float
  backupLigado  Boolean
  temAlteracao  Boolean
  criadoEm      DateTime   @default(now())
  alteracao     Alteracao?

  @@map("inspecoes")
}

model Alteracao {
  id              String   @id @default(uuid())
  inspecaoId      String   @unique
  tipo            String   // "eletrica" | "hidraulica" | "patrimonio"
  descricao       String
  foto            String?  // base64
  trilogoChamado  Boolean
  inspecao        Inspecao @relation(fields: [inspecaoId], references: [id])

  @@map("alteracoes")
}
