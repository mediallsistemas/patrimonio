generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String               @id @default(uuid())
  slug                String               @unique
  nome                String
  ativo               Boolean              @default(true)
  criadoEm            DateTime             @default(now())
  atualizadoEm        DateTime             @updatedAt
  logoUrl             String?
  trilogoCompanyId    Int?                 // ID da empresa no Trilogo (ex: 168 = Amapá)
  trilogoProjectName  String?              // Nome do projeto/hospital no Trilogo (ex: "HRPG")
  linensistem         Boolean              @map("linenSistem") @default(false) // Tenant ativo no LinenSistem
  ambientes           AmbienteTenant[]
  blocos              BlocoTenant[]
  movimentacoes       Movimentacao[]
  pessoas             Pessoa[]
  respostasFormulario RespostaFormulario[]
  rodadas             Rodada[]
  agendamentosManutencao AgendamentoManutencao[]
  manutencoesRealizadas  ManutencaoRealizada[]
  rondasDraft            RondaDraft[]
  rondasOcorrencias      RondaOcorrencia[]
  templatesFormulario    TemplateFormulario[]
  usuarios               Usuario[]
  chamados               Chamado[]

  @@map("tenants")
}

model Usuario {
  id                         String                  @id @default(uuid())
  tenantId                   String?
  email                      String                  @unique
  username                   String?                 @unique
  senhaHash                  String
  nome                       String
  role                       String                  @default("tenant_admin")
  sistemas                   String[]
  ativo                      Boolean                 @default(true)
  mustChangePassword         Boolean                 @default(false)
  tenantsExtras              String[]                @default([])
  criadoEm                   DateTime                @default(now())
  atualizadoEm               DateTime                @updatedAt
  agendamentosAtualizados    AgendamentoManutencao[] @relation("AgendamentoAtualizadoPor")
  agendamentosCriados        AgendamentoManutencao[] @relation("AgendamentoCriadoPor")
  manutencoesRealizadas      ManutencaoRealizada[]   @relation("ManutencaoCriadaPor")
  respostasFormularioCriadas RespostaFormulario[]    @relation("RespostaCriadaPor")
  rodadasCriadas             Rodada[]                @relation("RodadaCriadaPor")
  draftsOcorrencias          RondaDraft[]            @relation("DraftCriadoPor")
  rondasCriadas              RondaOcorrencia[]       @relation("RondaCriadaPor")
  chamadosCriados            Chamado[]               @relation("ChamadoCriadoPor")
  chamadosResponsavel        Chamado[]               @relation("ChamadoResponsavel")
  tenant                     Tenant?                 @relation(fields: [tenantId], references: [id])

  @@map("usuarios")
}

model Pessoa {
  id             String         @id @default(uuid())
  nome           String
  cpf            String
  faceDescriptor String
  tenantId       String
  atualizadoEm   DateTime       @updatedAt
  criadoEm       DateTime       @default(now())
  movimentacoes  Movimentacao[]
  tenant         Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@map("pessoas")
}

model Movimentacao {
  id       String   @id @default(uuid())
  pessoaId String
  tipo     String
  dataHora DateTime @default(now())
  tenantId String
  pessoa   Pessoa   @relation(fields: [pessoaId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([pessoaId])
  @@index([tenantId, tipo])
  @@index([tenantId, dataHora])
  @@index([pessoaId, tipo])
  @@map("movimentacoes")
}

model Rodada {
  id           String                 @id @default(uuid())
  iniciadoEm   DateTime               @default(now())
  finalizadoEm DateTime?
  tenantId     String
  criadoPorId  String
  ambientes    AmbienteInspecionado[]
  criadoPor    Usuario                @relation("RodadaCriadaPor", fields: [criadoPorId], references: [id])
  tenant       Tenant                 @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, iniciadoEm])
  @@map("rodadas")
}

model AmbienteInspecionado {
  id               String         @id @default(uuid())
  rodadaId         String
  ambiente         String
  purezaO2         Float
  pressaoO2        Float
  pressaoAr        Float
  backupLigado     Boolean
  temAlteracao     Boolean
  concluidoEm      DateTime       @default(now())
  temAbastecimento Boolean        @default(false)
  abastecimento    Abastecimento?
  alteracao        Alteracao?
  rodada           Rodada         @relation(fields: [rodadaId], references: [id])

  @@map("ambientes_inspecionados")
}

model Abastecimento {
  id                     String               @id @default(uuid())
  ambienteInspecionadoId String               @unique
  quantidade             Int
  tamanho                String
  ambienteInspecionado   AmbienteInspecionado @relation(fields: [ambienteInspecionadoId], references: [id])

  @@map("abastecimentos")
}

model Alteracao {
  id                     String               @id @default(uuid())
  ambienteInspecionadoId String               @unique
  tipo                   String
  descricao              String
  foto                   String?
  trilogoChamado         Boolean
  ambienteInspecionado   AmbienteInspecionado @relation(fields: [ambienteInspecionadoId], references: [id])

  @@map("alteracoes")
}

model RondaOcorrencia {
  id           String             @id @default(uuid())
  iniciadoEm   DateTime           @default(now())
  finalizadoEm DateTime?
  atualizadoEm DateTime           @updatedAt
  tenantId     String
  criadoPorId  String
  ambientes    RegistroAmbiente[]
  criadoPor    Usuario            @relation("RondaCriadaPor", fields: [criadoPorId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, iniciadoEm])
  @@index([finalizadoEm])
  @@map("rondas_ocorrencias")
}

model RegistroAmbiente {
  id            String              @id @default(uuid())
  rondaId       String
  ambiente      String
  // 'ocorrencia' = ronda normal | 'gases' = inspeção de gases
  tipoRegistro  String              @default("ocorrencia")
  temOcorrencia Boolean
  concluidoEm   DateTime            @default(now())
  // Campos exclusivos de inspeção de gases (nullable)
  purezaO2      Float?
  pressaoO2     Float?
  pressaoAr     Float?
  backupLigado  Boolean?
  // Abastecimento de cilindros (gases)
  temAbastecimento Boolean?
  qtdCilindros  Int?
  tamCilindro   String?
  ocorrencias   OcorrenciaDetalhe[]
  ronda         RondaOcorrencia     @relation(fields: [rondaId], references: [id])

  @@index([rondaId])
  @@map("registros_ambientes")
}

model OcorrenciaDetalhe {
  id             String           @id @default(uuid())
  registroId     String
  tipo           String
  descricao      String
  foto           String?
  trilogoChamado Boolean
  bemPatrimony   String?
  bemDescricao   String?
  registro       RegistroAmbiente @relation(fields: [registroId], references: [id])

  @@index([registroId])
  @@map("ocorrencias_detalhe")
}

// Blocos organizacionais por tenant (ex: "Bloco Cirúrgico", "Bloco Conforto")
model BlocoTenant {
  id        String           @id @default(uuid())
  tenantId  String
  nome      String
  ordem     Int              @default(0)
  ativo     Boolean          @default(true)
  ambientes AmbienteTenant[]
  tenant    Tenant           @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("blocos_tenant")
}

// Ambientes configuráveis por tenant (usados na ronda de ocorrências)
model AmbienteTenant {
  id       String      @id @default(uuid())
  tenantId String
  blocoId  String?
  nome     String
  ordem    Int         @default(0)
  ativo    Boolean     @default(true)
  // 'ocorrencia' = ronda normal | 'gases' = inspeção de gases medicinais
  tipo     String      @default("ocorrencia")
  bloco    BlocoTenant? @relation(fields: [blocoId], references: [id])
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  manutencoes ManutencaoRealizada[]
  chamados Chamado[]

  @@index([tenantId])
  @@index([blocoId])
  @@map("ambientes_tenant")
}

model RondaDraft {
  id           String   @id @default(uuid())
  tenantId     String
  criadoPorId  String
  estado       Json
  atualizadoEm DateTime @updatedAt
  criadoPor    Usuario  @relation("DraftCriadoPor", fields: [criadoPorId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, criadoPorId])
  @@map("rondas_draft")
}

model AgendamentoManutencao {
  id              String   @id @default(uuid())
  trilogoAssetId  Int
  patrimony       String
  descricaoBem    String
  companyId       Int
  companyName     String
  ambiente        String
  dataAgendada    DateTime
  observacao      String?
  criadoEm        DateTime @default(now())
  status          String   @default("pendente")
  titulo          String   @default("Manutenção")
  criadoPorId     String
  atualizadoEm    DateTime  @updatedAt
  atualizadoPorId String?
  dataRealizada   DateTime?
  tenantId        String?
  atualizadoPor   Usuario?  @relation("AgendamentoAtualizadoPor", fields: [atualizadoPorId], references: [id])
  criadoPor       Usuario   @relation("AgendamentoCriadoPor", fields: [criadoPorId], references: [id])
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([companyId])
  @@map("agendamentos_manutencao")
}

// Manutenção realizada pelo operador (elétrica, hidráulica ou patrimônio).
// Para elétrica/hidráulica: vinculada a um ambiente. Para patrimônio: vinculada a um bem do Trilogo.
// Snapshots de nome/descrição preservam histórico mesmo se o ambiente/bem for removido.
model ManutencaoRealizada {
  id                    String    @id @default(uuid())
  tenantId              String
  criadoPorId           String
  // 'eletrica' | 'hidraulica' | 'predial' | 'patrimonio'
  // 'predial' vem do LinenSistem e continua sendo gravado — 29 registros em
  // producao. Ja esteve fora desta lista, o que fez a tela de manutencoes
  // renderizar essas linhas sem rotulo.
  tipo                  String
  status                String    @default("em_andamento") // 'em_andamento' | 'concluida'

  // Ambiente (apenas para eletrica/hidraulica)
  ambienteId            String?
  ambienteNomeSnapshot  String?
  blocoNomeSnapshot     String?

  // Bem do Trilogo (apenas para patrimonio)
  trilogoAssetId        Int?
  patrimony             String?
  descricaoBemSnapshot  String?
  // Subtipo de manutenção do bem (apenas para patrimonio) — mesma lista do dropdown de agendamento
  subtipoPatrimonio     String?

  descricao             String
  observacaoFinal       String?
  fotoAntes             String    // base64 obrigatória ao iniciar
  fotoDepois            String?   // base64 preenchida ao finalizar

  iniciadaEm            DateTime  @default(now())
  finalizadaEm          DateTime?
  atualizadoEm          DateTime  @updatedAt

  ambiente              AmbienteTenant? @relation(fields: [ambienteId], references: [id], onDelete: SetNull)
  criadoPor             Usuario   @relation("ManutencaoCriadaPor", fields: [criadoPorId], references: [id])
  tenant                Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, tipo, iniciadaEm])
  @@index([criadoPorId, status])
  @@map("manutencoes_realizadas")
}

// Chamado de manutenção: aberto por operador/admin, assumido (ou atribuído por
// admin) e finalizado reusando o fluxo de ocorrências. "Atrasado" é derivado
// (status aberto/em_execucao com prazo vencido) — nunca persistido.
// Campos fiscais (fornecedor/ordem de compra/valor) são restritos a admin.
model Chamado {
  id                   String    @id @default(uuid())
  numero               Int       @unique @default(autoincrement()) // código legível (#123)
  tenantId             String
  criadoPorId          String

  titulo               String
  descricao            String
  // 'eletrica' | 'hidraulica' | 'civil' | ... — ver TIPOS_CHAMADO em chamados.types.ts
  tipo                 String
  prioridade           String    @default("media") // 'baixa' | 'media' | 'alta' | 'urgente'
  status               String    @default("aberto") // 'aberto' | 'em_execucao' | 'finalizado' | 'cancelado'
  // Opcional: ticket do Trilogo frequentemente nao traz deadline (219 de 868 na
  // amostra de producao). Inventar um prazo produziria atraso falso; sem prazo,
  // estaAtrasado devolve false e a tela mostra "—".
  prazo                DateTime?

  // Ambiente (snapshot preserva histórico se o ambiente for removido)
  ambienteId           String?
  ambienteNomeSnapshot String?
  blocoNomeSnapshot    String?

  // Bem do Trilogo (opcional)
  trilogoAssetId       Int?
  patrimony            String?
  descricaoBemSnapshot String?

  // Ticket de origem no Trilogo, quando o chamado nasceu de uma sincronizacao.
  // Unico: e a chave de idempotencia — reexecutar a sincronizacao nao duplica.
  // Nulo = chamado aberto pelo proprio sistema.
  trilogoTicketId      Int?      @unique
  // currentStatus.actionDescription cru, como veio do Trilogo no momento da
  // importacao. Guardado porque a traducao para o nosso ciclo de vida e uma
  // interpretacao: com o texto original, um mapeamento errado e corrigivel
  // depois com um UPDATE, em vez de ser perda de informacao.
  trilogoStatusOrigem  String?

  // Foto na abertura (base64, mesmo teto ~1.5MB dos demais fluxos)
  fotoAbertura         String?

  // Atribuição / responsável — sempre IDs vindos do JWT, nunca do body
  responsavelId        String?
  atribuidoPorId       String?
  assumidoEm           DateTime?

  // Execução / finalização (payload no formato do fluxo de ocorrências)
  descricaoExecucao    String?
  fotoExecucao         String?
  finalizadoEm         DateTime?
  finalizadoPorId      String?

  // Cancelamento (admin) — motivo opcional
  motivoCancelamento   String?

  // Campos fiscais — SOMENTE admin escreve/lê (sanitizados para outros roles)
  fornecedor           String?
  numeroOrdemCompra    String?
  valorGastoCentavos   Int?      // centavos — nunca float em moeda

  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt
  atualizadoPorId      String?

  ambiente             AmbienteTenant? @relation(fields: [ambienteId], references: [id], onDelete: SetNull)
  criadoPor            Usuario   @relation("ChamadoCriadoPor", fields: [criadoPorId], references: [id])
  responsavel          Usuario?  @relation("ChamadoResponsavel", fields: [responsavelId], references: [id])
  tenant               Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, prioridade])
  @@index([tenantId, prazo])
  @@index([tenantId, criadoEm])
  @@index([responsavelId, status])
  @@map("chamados")
}

model LinkPublicoBem {
  id        String   @id @default(uuid())
  companyId Int
  projeto   String
  ambiente  String
  tenantId  String
  criadoEm  DateTime @default(now())

  @@unique([companyId, projeto, ambiente])
  @@index([companyId])
  @@map("links_publicos_bens")
}

model TemplateFormulario {
  id           String               @id @default(uuid())
  tenantId     String
  nome         String
  campos       Json
  ativo        Boolean              @default(true)
  criadoEm     DateTime             @default(now())
  atualizadoEm DateTime             @updatedAt
  respostas    RespostaFormulario[]
  tenant       Tenant               @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("templates_formulario")
}

model RespostaFormulario {
  id             String              @id @default(uuid())
  tenantId       String
  templateId     String?
  nomePaciente   String?
  cpf            String?
  idade          Int?
  genero         String?
  dataInternacao DateTime?
  dataAlta       DateTime?
  setor          String?
  respostas      Json
  comentarios    String?
  criadoEm       DateTime            @default(now())
  deletadoEm     DateTime?
  criadoPorId    String?
  criadoPor      Usuario?            @relation("RespostaCriadaPor", fields: [criadoPorId], references: [id])
  template       TemplateFormulario? @relation(fields: [templateId], references: [id])
  tenant         Tenant              @relation(fields: [tenantId], references: [id])

  @@index([tenantId, deletadoEm])
  @@index([tenantId, setor])
  @@index([tenantId, criadoEm])
  @@map("respostas_formulario")
}

/// Tickets do Trilogo que a sincronizacao NAO conseguiu virar chamado.
///
/// Existe porque a janela de busca e movel (7 dias): sem persistir, um ticket
/// recusado sumia do relatorio da execucao seguinte e, passada a janela, deixava
/// de ser buscado — perdido em silencio. Aqui ele fica ate alguem resolver.
///
/// Nao guarda dado do Trilogo alem do necessario para a triagem: e uma fila de
/// pendencias, nao um espelho.
model TicketTrilogoTriagem {
  trilogoTicketId Int       @id
  /// Por que nao entrou. Para status desconhecido, traz o texto literal da origem.
  motivo          String
  /// currentStatus.actionDescription cru, quando havia. E como descobrimos
  /// quais valores de status existem de fato na base do cliente.
  statusOrigem    String?
  descricao       String?
  endereco        String?
  companyId       Int?
  primeiraVezEm   DateTime  @default(now())
  ultimaVezEm     DateTime  @updatedAt
  /// Quantas execucoes ja recusaram este ticket. Repeticao alta = regra a ajustar.
  ocorrencias     Int       @default(1)
  /// Preenchido quando o ticket finalmente virou chamado.
  resolvidoEm     DateTime?

  @@index([resolvidoEm, ultimaVezEm])
  @@map("tickets_trilogo_triagem")
}
